FROM casbin/casdoor:v4.29.0

USER root
RUN sed -i 's|http://|https://|g' /etc/apk/repositories \
    && apk upgrade --no-cache \
    && apk add --no-cache stunnel valkey-cli \
    && sed -i 's/^runmode = dev.*/runmode = prod/' /conf/app.conf \
    && grep -qx 'runmode = prod' /conf/app.conf
COPY --chmod=0755 start.sh /usr/local/bin/start-casdoor
USER 1000

ENV PORT=8000 \
    driverName=postgres \
    dbName=casdoor \
    showSql=false \
    isDemoMode=false \
    enableErrorMask=true \
    disableUpgrade=true \
    logConfig='{"adapter":"console"}'

EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/start-casdoor"]
